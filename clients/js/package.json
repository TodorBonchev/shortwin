{
  "name": "@shortwin/client",
  "version": "0.1.0",
  "private": true,
  "description": "short.win program client for @solana/kit, generated by Codama from the Anchor IDL (ARCHITECTURE §1.1, §1.2). The IDL copy and the generated code are committed; CI rebuilds both and fails on a diff.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "idl",
    "src"
  ],
  "scripts": {
    "idl:sync": "node scripts/sync-idl.mjs",
    "generate": "codama run js --config ../../codama.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@solana/kit": "8.3.0"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@types/node": "24.19.0",
    "codama": "1.11.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
